# Porta definida automaticamente pelo provedor do backend.
PORT="3000"
NODE_ENV="production"

# Dominios autorizados a consumir a API, separados por virgula.
CORS_ORIGINS="https://frontend-do-cliente.exemplo,http://localhost:5173"

# Banco e storage do cliente.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_MEDIA_BUCKET="pulsefit-media"
SUPABASE_PRODUCT_BUCKET="pulsefit-products"

# Segredo de sessao. Gere um valor unico por cliente no ambiente, nunca no codigo.
JWT_SECRET=""

# Admin inicial. Prefira ADMIN_PASSWORD_HASH em producao.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""
ADMIN_ACCESS_CODE=""

# Limites defensivos anti-abuso.
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
LOGIN_RATE_LIMIT_WINDOW_MS="900000"
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="5"
